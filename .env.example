APP_NAME=ZenCoParent
APP_ENV=production
APP_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
APP_URL=http://localhost
APP_DEBUG=false
# Port HTTP expose par le conteneur nginx.
APP_PORT=8061

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=zencoparent
DB_USERNAME=zencoparent
DB_PASSWORD=secret

# Redis est optionnel : laisser vide desactive le rate limiting.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# MinIO est optionnel : laisser vide stocke les fichiers sur disque local.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zencoparent
MINIO_REGION=us-east-1

# Stockage sur disque local — utilise uniquement si MINIO_ENDPOINT est vide.
STORAGE_PATH=/var/www/html/storage
STORAGE_URL=http://localhost/storage

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/auth/oauth/google/callback

JWT_SECRET=change-me-to-another-long-random-secret
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=2592000

CSRF_SECRET=change-me-csrf-secret

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ── Email / SMTP transactionnel ───────────────────────────────────────────────
# Laisser MAIL_HOST vide pour désactiver l'envoi d'e-mails.
# Compatible Mailtrap, Resend SMTP, SendGrid, Postmark, Gmail, etc.
#
# Exemple Mailtrap (sandbox de test, aucun mail réel envoyé) :
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=<votre_user_mailtrap>
#   MAIL_PASSWORD=<votre_pass_mailtrap>
#
# Exemple Gmail (activer "App password" dans les paramètres compte) :
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=votre@gmail.com
#   MAIL_PASSWORD=<app_password_16_chars>
#
# Exemple Resend SMTP :
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=465
#   MAIL_ENCRYPTION=ssl
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=<votre_api_key_resend>
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@zencoparent.com
MAIL_FROM_NAME=ZenCoParent


# ─────────────────────────────────────────────────────────────────────────────
# ZenCoParent — configuration de déploiement
#
# SMTP, OAuth Google et paramètres de sécurité se règlent ensuite dans
# l'interface admin (Paramètres), pas ici.
#
# Pour générer un secret :  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Version déployée ─────────────────────────────────────────────────────────
# Dépôt GitHub et branche/tag à construire. Remplacer #main par un tag
# (ex: #v1.0.0) pour figer une version.
ZENCO_SOURCE=https://github.com/frenchtux/ZenCoParent.git#main

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=ZenCoParent
APP_ENV=production
APP_DEBUG=false
# Adresse publique, sans slash final. Le certificat HTTPS est obtenu
# automatiquement pour ce domaine : son DNS doit pointer vers ce serveur.
APP_URL=https://zencoparent.example.com
# Ports exposés sur l'hôte. Let's Encrypt exige 80 et 443 joignables depuis
# Internet : ne les changer que derrière une redirection de ports.
HTTP_PORT=80
HTTPS_PORT=443
# Uniquement si un autre reverse proxy porte déjà le HTTPS (voir README) :
# CADDY_ADDRESS=:80 et TRUSTED_PROXIES=<IP du proxy>. Vides = HTTPS
# automatique pour APP_URL.
CADDY_ADDRESS=
TRUSTED_PROXIES=

# Chiffre aussi les secrets stockés en base (mot de passe SMTP, OAuth...).
# NE PLUS LE CHANGER après l'installation.
APP_SECRET=

JWT_SECRET=
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=2592000
CSRF_SECRET=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=zencoparent
DB_USERNAME=zencoparent
DB_PASSWORD=

# ── Redis (rate limiting) ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# ── Fichiers (photos, pièces jointes) : disque local, volume "storage" ───────
MINIO_ENDPOINT=
STORAGE_PATH=/var/www/html/storage
STORAGE_URL=/storage

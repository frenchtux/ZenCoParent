# ── Version control ───────────────────────────────────────────────────────────
.git
.gitattributes
.gitignore

# ── Environment files (never bake secrets into the image) ─────────────────────
.env
.env.*
!.env.example

# ── Docker files (not needed inside the image) ────────────────────────────────
docker-compose*.yml
.dockerignore

# ── PHP vendor (installed inside the image by composer) ───────────────────────
vendor/

# ── Runtime artifacts ─────────────────────────────────────────────────────────
storage/

# ── Not needed at runtime (tests, tooling, private scripts, other apps) ───────
tests/
phpunit.xml
.phpunit.*
scripts/
android/
deploy/
.github/
.claude/
.claudecode/
*.md

# ── OS noise ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
